# /.env.production.example
# Template de producao.
# Copie para .env.production e troque todos os valores CHANGE_ME antes de publicar.

APP_ENV=production
NODE_ENV=production

STACK_NAME=surb
REGISTRY=local
IMAGE_TAG=latest
PLATFORMS=linux/amd64,linux/arm64

DOMAIN=surb.com.br
APP_URL=https://surb.com.br
API_URL=https://surb.com.br/api
AUTH_URL=https://surb.com.br/auth
TRAEFIK_CERT_RESOLVER=letsencryptresolver

POSTGRES_USER=surb_app
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=surb
DATABASE_URL=postgresql://surb_app:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/surb

REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

LOG_LEVEL=info
CORS_ORIGINS=https://surb.com.br
PUBLIC_HOST=surb.com.br

JWT_ACCESS_TOKEN_SECRET=CHANGE_ME_ACCESS_JWT_SECRET
JWT_ACCESS_TOKEN_EXPIRES_IN=900
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_JWT_SECRET
JWT_REFRESH_TOKEN_SECRET=CHANGE_ME_REFRESH_JWT_SECRET
JWT_REFRESH_TOKEN_EXPIRES_IN=604800

ACCESS_TOKEN_SECRET=CHANGE_ME_ACCESS_TOKEN_SECRET
ACCESS_TOKEN_EXPIRES_IN=900
REFRESH_TOKEN_SECRET=CHANGE_ME_REFRESH_TOKEN_SECRET
REFRESH_TOKEN_EXPIRES_IN=604800

COOKIE_SECRET=CHANGE_ME_COOKIE_SECRET
SESSION_COOKIE_NAME=sid
SESSION_COOKIE_SECURE=true
SESSION_TTL_SECONDS=604800

NEXT_PUBLIC_APP_NAME="SURB Servicos Urbanos"
NEXT_PUBLIC_APP_URL=https://surb.com.br
NEXT_PUBLIC_API_URL=https://surb.com.br/api
NEXT_PUBLIC_AUTH_URL=https://surb.com.br/auth
BASE_URL=https://surb.com.br
SHORT_NAME=SURB
CONTACT_EMAIL=contato@surb.com.br
WHATSAPPs=5583999999999
